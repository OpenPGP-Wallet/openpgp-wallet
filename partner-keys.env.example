# Partner API keys, read at build time by core/build.rs.
# Copy this file to `partner-keys.env` (ignored by git) and fill in the keys you have.
# Every key is optional: without one, the matching provider is not offered and the
# app falls back to the block explorer for history.

# Swaps through NEAR Intents and Chainflip.
SWAPKIT_API_KEY=
# Swaps through MoonPay Trade (a Trade key from console.swaps.xyz, not a MoonPay widget key).
MOONPAY_TRADE_API_KEY=
# BNB Chain transaction history.
NODEREAL_API_KEY=
# Bittensor transaction history.
TAOSTATS_API_KEY=
# Arbitrum history (Blockscout's official API).
BLOCKSCOUT_API_KEY=
# Base and Polygon history.
ALCHEMY_API_KEY=
