{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPGP Wallet",
  "version": "2.13.2",
  "identifier": "com.pgpwalletpoc.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenPGP Wallet",
        "theme": "Dark",
        "width": 1080,
        "height": 720,
        "center": true,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Khadim",
    "copyright": "© 2026 Khadim",
    "shortDescription": "Non-custodial crypto wallet protected by OpenPGP",
    "longDescription": "Non-custodial, multi-network crypto wallet with no seed phrase to write down: the master key is protected by OpenPGP and a 2-of-3 Shamir backup kit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
